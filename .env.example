# Smart Stock Environment Variables

# API Configuration
PROJECT_NAME="Smart Stock Secure API"
MAX_PAGE_SIZE=100
CORS_ORIGINS="http://localhost:8501,http://localhost:3000"

# Security (JWT)
JWT_SECRET="replace-this-with-a-very-long-secure-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL="sqlite:///./smartstock.db"

# Twilio Configuration
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Rate Limit Configuration
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REFRESH="20/minute"
RATE_LIMIT_RETRAIN="2/hour"
